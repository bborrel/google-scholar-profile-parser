{
    "name": "bborrel/google-scholar-profile-parser",
    "description": "Parses a profile page from Google Scholar.",
    "type": "library",
    "license": "GPL-3.0-only",
    "authors": [
        {
            "name": "Benoit Borrel",
            "email": "benoit@borrel.com"
        }
    ],
    "require": {
        "php": ">=8.2",
        "ext-dom": "*",
        "symfony/browser-kit": "^6.4 || ^7.0",
        "symfony/http-client": "^6.4 || ^7.0"
    },
    "require-dev": {
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "edgedesign/phpqa": "^1.26",
        "enlightn/security-checker": "^2.0",
        "friendsofphp/php-cs-fixer": "^3.95",
        "infection/infection": "^0.32",
        "nette/neon": "^3.4",
        "pheromone/phpcs-security-audit": "^2.0",
        "php-coveralls/php-coveralls": "^2.7",
        "php-parallel-lint/php-console-highlighter": "^1.0",
        "php-parallel-lint/php-parallel-lint": "^1.0",
        "phpcompatibility/php-compatibility": "^9.3",
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^11.5",
        "symplify/phpstan-rules": "^14.2",
        "vimeo/psalm": "^6.16"
    },
    "autoload": {
        "psr-4": {
            "GScholarProfileParser\\": "src/"
        },
        "exclude-from-classmap": ["/tests/"]
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "infection/extension-installer": true
        }
    },
    "scripts": {
        "phpunit": "vendor/bin/phpunit",
        "phpcs": "vendor/bin/phpcs --standard=PSR1,PSR12,Security -p src doc",
        "phpcbf": "vendor/bin/phpcbf --standard=PSR1,PSR12,Security -p src doc",
        "phpmd": "vendor/bin/phpmd src,doc text cleancode,codesize,controversial,design,naming,unusedcode",
        "phpstan": "vendor/bin/phpstan analyze --level=2 -vvv src doc",
        "ci": [
            "@phpunit",
            "@phpcs",
            "@phpcbf",
            "@phpmd",
            "@phpstan"
        ]
    }
}
